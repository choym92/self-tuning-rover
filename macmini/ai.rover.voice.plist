<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Kalman's voice on the home Mac mini: Supertonic 3 (jetson/tts/supertonic/st_server.py) on loopback 8093,
     about 5x faster than on the Jetson CPU (docs/verify.md, 2026-11-07). User LaunchAgent like ai.rover.brain.
     Install: cp ai.rover.voice.plist ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/ai.rover.voice.plist
     Remove:  launchctl bootout gui/$(id -u)/ai.rover.voice && rm ~/Library/LaunchAgents/ai.rover.voice.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.rover.voice</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/paul/rover-brain/tts/venv/bin/python</string>
    <string>/Users/paul/rover-brain/tts/st_server.py</string>
    <string>--assets</string><string>/Users/paul/rover-brain/tts/models/supertonic-3</string>
    <string>--port</string><string>8093</string>
    <string>--host</string><string>127.0.0.1</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/paul/rover-brain/tts</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>/Users/paul/rover-brain/tts/st.log</string>
  <key>StandardErrorPath</key><string>/Users/paul/rover-brain/tts/st.log</string>
</dict>
</plist>
